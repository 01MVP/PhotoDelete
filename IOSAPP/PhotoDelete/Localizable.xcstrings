    "删图不接入自己的云端服务，也不会把照片发到服务器。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستخدم OnePhoto خدمة سحابية خاصة به ولا يرسل الصور إلى خادم أبدا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhoto nutzt keinen eigenen Cloud-Dienst und sendet Fotos nie an einen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhoto does not use its own cloud service and never sends photos to a server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhotoは独自のクラウドサービスを使わず、写真をサーバーに送信することもありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图不接入自己的云端服务，也不会把照片发到服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖不接入自己的雲端服務，也不會把照片發到服務器。"
          }
        }
      }
    },
