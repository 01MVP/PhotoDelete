    "原视频 %@，压缩后 %@。本次没有明显减少空间，建议保留原视频。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصلي %@، بعد الضغط %@. لم يتم توفير مساحة ملحوظة، لذا احتفظ بالفيديو الأصلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original %@, komprimiert %@. Das spart kaum Speicherplatz, daher solltest du das Original behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original %@, compressed %@. This did not noticeably reduce space, so keep the original video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のビデオ %@、圧縮後 %@。今回は空き容量がほとんど増えなかったため、元のビデオを残すことをおすすめします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "原视频 %@，压缩后 %@。本次没有明显减少空间，建议保留原视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原影片 %@，壓縮後 %@。本次沒有明顯減少空間，建議保留原影片。"
          }
        }
      }
    },
