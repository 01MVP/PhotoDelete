    "左滑下一张，右滑上一张，上滑删除": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لليسار للتالية، ولليمين للسابقة، وللأعلى للحذف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links für nächstes, rechts für vorheriges, oben zum Löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left for next, right for previous, up to delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左で次へ、右で前へ、上で削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑下一张，右滑上一张，上滑删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑下一張，右滑上一張，上滑刪除"
          }
        }
      }
    },
    "左滑保留，右滑删除，上滑收藏": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لليسار للاحتفاظ، ولليمين للحذف، وللأعلى للتفضيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links behalten, rechts löschen, oben favorisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to keep, right to delete, up to favorite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左で保持、右で削除、上でお気に入り"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑保留，右滑刪除，上滑收藏"
          }
        }
      }
    },
    "左滑保留，右滑删除，上滑收藏。所有删除都会在最后统一确认。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لليسار للاحتفاظ، ولليمين للحذف، وللأعلى للتفضيل. يتم تأكيد عمليات الحذف في النهاية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach links wischen zum Behalten, nach rechts zum Löschen und nach oben zum Favorisieren. Löschungen werden am Ende bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to keep, right to delete, and up to favorite. Deletes are confirmed at the end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左にスワイプで保持、右で削除、上でお気に入り。削除は最後にまとめて確認されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑保留，右滑刪除，上滑收藏。所有刪除都會在最後統一確認。"
          }
        }
      }
    },
    "左滑保留，右滑删除，上滑收藏。点完成后再统一确认。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لليسار للاحتفاظ، ولليمين للحذف، وللأعلى للتفضيل. اضغط تم لتأكيد كل شيء معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach links wischen zum Behalten, nach rechts zum Löschen und nach oben zum Favorisieren. Tippe auf Fertig, um alles gemeinsam zu bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to keep, right to delete, and up to favorite. Tap Done to confirm everything together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左にスワイプで保持、右で削除、上でお気に入り。完了をタップしてまとめて確認します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑保留，右滑刪除，上滑收藏。點完成後再統一確認。"
          }
        }
      }
    },
