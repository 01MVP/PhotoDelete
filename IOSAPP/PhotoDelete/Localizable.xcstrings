    "滑动、撤销和归类时提供轻微反馈": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهتزاز خفيف عند السحب والتراجع والفرز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
