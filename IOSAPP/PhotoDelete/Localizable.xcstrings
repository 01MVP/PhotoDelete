    "还剩 %lld 天。试用期间可使用进阶清理、长期统计和主题切换。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى %lld يومًا. تتوفر ميزات التنظيف المتقدم والإحصاءات طويلة المدى وتبديل المظهر أثناء الفترة التجريبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %lld Tage. Während der Testphase sind erweiterte Bereinigung, Langzeitstatistiken und Designwechsel verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days remaining. Advanced cleanup, long-term stats, and theme switching are available during the trial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%lld日。試用期間中は高度な整理、長期統計、テーマ切り替えを利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "还剩 %lld 天。试用期间可使用进阶清理、长期统计和主题切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還剩 %lld 天。試用期間可使用進階清理、長期統計和主題切換。"
          }
        }
      }
    },
