          "stringUnit": {
            "state": "translated",
            "value": "Nach links wischen zum Löschen, nach rechts zum Überspringen und nach oben zum Favorisieren. Löschungen werden am Ende bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to delete, right to skip, and up to favorite. Deletes are confirmed at the end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左にスワイプで削除、右でスキップ、上でお気に入り。削除は最後にまとめて確認されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑刪除，右滑跳過，上滑收藏。所有刪除都會在最後統一確認。"
          }
        }
      }
    },
    "左滑删除，右滑跳过，上滑收藏。点完成后再统一确认。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لليسار للحذف، ولليمين للتخطي، وللأعلى للتفضيل. اضغط تم لتأكيد كل شيء معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
