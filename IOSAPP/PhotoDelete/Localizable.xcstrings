    "权限、撤销、反馈和隐私说明都围绕实际使用补齐。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إعداد الأذونات والتراجع والملاحظات ونصوص الخصوصية حول الاستخدام الفعلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen, Rückgängig, Feedback und Datenschutztexte sind auf die echte Nutzung abgestimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions, undo, feedback, and privacy copy are built around real use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限、取り消し、フィードバック、プライバシー説明は実際の利用に合わせて整えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "权限、撤销、反馈和隐私说明都围绕实际使用补齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限、撤銷、反饋和隱私說明都圍繞實際使用補齊。"
          }
        }
      }
    },
    "柔和一点，减少纯白界面的工具感。": {
