    "更明显压缩体积，适合备份或低重要性图片。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضغط بحجم أكبر للنسخ الاحتياطية أو الصور الأقل أهمية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimiert stärker, passend für Backups oder weniger wichtige Bilder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresses more aggressively for backups or less important images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より強く圧縮します。バックアップや重要度の低い画像に適しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "更明显压缩体积，适合备份或低重要性图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更明顯壓縮體積，適合備份或低重要性圖片。"
          }
        }
      }
    },
    "更明显降低码率，适合只想腾出空间的视频。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفض معدل البت بدرجة أكبر للفيديوهات التي يكون توفير المساحة فيها الأهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkt die Bitrate stärker für Videos, bei denen Speicherplatz am wichtigsten ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowers bitrate more aggressively for videos where space matters most."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビットレートをより大きく下げます。空き容量を優先したいビデオに適しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "更明显降低码率，适合只想腾出空间的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更明顯降低位元率，適合只想騰出空間的影片。"
          }
        }
      }
    },
    "更温暖，适合长时间整理。": {
      "localizations": {
        "ar": {
          "stringUnit": {
