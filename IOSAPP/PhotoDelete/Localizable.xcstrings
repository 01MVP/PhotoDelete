    "%@ 等 %lld 个相册": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and %2$lld albums"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 等 %2$lld 个相册"
          }
        },
