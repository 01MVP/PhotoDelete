          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fotos können nicht als Favorit markiert werden. Prüfe zuerst Berechtigungen oder Quelle in Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some photos cannot be favorited. Check their permissions or source in Photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加できない写真があります。まず写真アプリで権限または保存元を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
