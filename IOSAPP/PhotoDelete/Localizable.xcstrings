    "基础整理继续免费。一次性解锁大文件清理、相似照片清理、长期统计和完整清理队列。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى التنظيف الأساسي مجانيًا. تفتح عملية شراء واحدة تنظيف الملفات الكبيرة والصور المتشابهة والإحصاءات الطويلة وقوائم التنظيف الكاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grundbereinigung bleibt kostenlos. Ein Kauf schaltet große Dateien, ähnliche Fotos, Langzeitstatistiken und vollständige Bereinigungslisten frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core cleanup stays free. One purchase unlocks large-file cleanup, similar-photo cleanup, long-term stats, and full cleanup queues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本整理は引き続き無料です。1回の購入で大容量ファイル整理、類似写真整理、長期統計、完全な整理キューを解除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "基础整理继续免费。一次性解锁大文件清理、相似照片清理、长期统计和完整清理队列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基礎整理繼續免費。一次性解鎖大檔案清理、相似照片清理、長期統計和完整清理佇列。"
          }
        }
      }
    },
    "基础清理功能始终免费。支持者版解锁长期统计，并支持删图继续维护。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزات التنظيف الأساسية مجانية دائمًا. يفتح Supporter الإحصاءات الطويلة ويساعد على استمرار صيانة OnePhoto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundfunktionen bleiben immer kostenlos. Supporter schaltet Langzeitstatistiken frei und unterstützt die Pflege von OnePhoto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core cleanup features are always free. Supporter unlocks long-term stats and helps keep OnePhoto maintained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本整理機能は常に無料です。サポーター版では長期統計が解除され、OnePhotoの継続的なメンテナンスを支援できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "基础清理功能始终免费。支持者版解锁长期统计，并支持删图继续维护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基礎清理功能始終免費。支持者版解鎖長期統計，並支持刪圖繼續維護。"
          }
        }
      }
    },
    "基础清理始终免费。支持者版解锁大文件、相似照片和长期统计等进阶工具。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى التنظيف الأساسي مجانيًا دائمًا. يفتح Supporter أدوات متقدمة للملفات الكبيرة والصور المتشابهة والإحصاءات الطويلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grundbereinigung bleibt immer kostenlos. Supporter schaltet erweiterte Tools für große Dateien, ähnliche Fotos und Langzeitstatistiken frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core cleanup is always free. Supporter unlocks advanced tools for large files, similar photos, and long-term stats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本整理は常に無料です。サポーター版では大容量ファイル、類似写真、長期統計などの高度なツールを解除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "基础清理始终免费。支持者版解锁大文件、相似照片和长期统计等进阶工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基礎清理始終免費。支持者版解鎖大檔案、相似照片和長期統計等進階工具。"
          }
