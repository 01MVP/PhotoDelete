    "高频界面只保留能帮助当下操作的信息。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الشاشات كثيرة الاستخدام فقط المعلومات اللازمة للإجراء الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufig genutzte Ansichten zeigen nur die Informationen, die für die aktuelle Aktion nötig sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequent screens keep only the information needed for the current action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う画面には、今の操作に必要な情報だけを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "高频界面只保留能帮助当下操作的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高頻界面只保留能幫助當下操作的信息。"
          }
        }
      }
    },
    "默认上滑只是先放进待删除，最后统一确认。手势和视频播放方式都可以在整理页快速调整。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتراضيًا، يؤدي السحب للأعلى فقط إلى إضافة الصورة إلى قائمة الحذف. تؤكد كل شيء في النهاية، ويمكنك تعديل الإيماءات وطريقة التشغيل من شاشة المراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig legt Wischen nach oben ein Foto nur in „Zu löschen“. Du bestätigst alles am Ende und kannst Gesten und Wiedergabe im Prüfbildschirm schnell anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, swiping up only adds a photo to To Delete. You confirm everything at the end, and can adjust gestures and playback from the review screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定では、上にスワイプすると写真は削除予定に追加されるだけです。最後にまとめて確認します。ジェスチャーや再生方法は確認画面ですぐに調整できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "默认上滑只是先放进待删除，最后统一确认。手势和视频播放方式都可以在整理页快速调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設上滑只是先放進待刪除，最後統一確認。手勢和影片播放方式都可以在整理頁快速調整。"
          }
        }
      }
    },
    "默认左滑删除、右滑保留、上滑收藏；想换手势，可以在整理页底部打开设置。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتراضيًا، اسحب لليسار للحذف، ولليمين للاحتفاظ، وللأعلى للإضافة إلى المفضلة. لتغيير الإيماءات، افتح الإعدادات أسفل شاشة المراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig löscht Wischen nach links, Wischen nach rechts behält und Wischen nach oben favorisiert. Zum Ändern der Gesten öffne unten im Prüfbildschirm die Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, swipe left to delete, right to keep, and up to favorite. To change gestures, open settings at the bottom of the review screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定では、左スワイプで削除、右スワイプで保持、上スワイプでお気に入りに追加します。変更するには、確認画面下部の設定を開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "默认左滑删除、右滑保留、上滑收藏；想换手势，可以在整理页底部打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設左滑刪除、右滑保留、上滑收藏；想換手勢，可以在整理頁底部打開設定。"
          }
        }
      }
    },
    "默认已勾选，取消勾选后不会执行。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محدد افتراضيًا. أزل التحديد لتخطيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig ausgewählt. Entferne die Auswahl, um den Eintrag zu überspringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected by default. Uncheck an item to skip it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定では選択済みです。チェックを外すとスキップされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "默认已勾选，取消勾选后不会执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設已勾選，取消勾選後不會執行。"
          }
        }
      }
    },
    "默认跟随 iPhone 系统语言。也可以在这里固定删图的显示语言。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتراضيًا، يتبع OnePhoto لغة iPhone. يمكنك أيضًا تثبيت لغة العرض هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig folgt OnePhoto der Sprache deines iPhone. Du kannst hier auch eine feste Anzeigesprache festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, OnePhoto follows your iPhone language. You can also pin a display language here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定では、OnePhoto は iPhone の言語に従います。ここで表示言語を固定することもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "默认跟随 iPhone 系统语言。也可以在这里固定删图的显示语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "默認跟隨 iPhone 系統語言。也可以在這裡固定刪圖的顯示語言。"
          }
        }
      }
    },
    "%lld 个相册删除失败，请稍后再试": {
      "localizations": {
