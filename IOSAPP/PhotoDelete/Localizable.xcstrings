    "清空记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空記錄"
          }
        }
      }
    },
    "只会清空本机记录，不会修改照片或待删除列表。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears only local history and won’t change photos or pending deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会清空本机记录，不会修改照片或待删除列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清空本機記錄，不會修改照片或待刪除列表。"
          }
        }
      }
    },
