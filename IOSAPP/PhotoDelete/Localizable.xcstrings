    "体验到期不会自动扣费，基础整理始终免费。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتم الخصم تلقائيًا بعد انتهاء التجربة. يظل التنظيف الأساسي مجانيًا دائمًا."
          }
        },
        "de": {
