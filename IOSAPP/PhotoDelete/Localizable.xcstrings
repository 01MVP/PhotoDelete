          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left to delete, right to skip, and up to favorite. Tap Done to confirm everything together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左にスワイプで削除、右でスキップ、上でお気に入り。完了をタップしてまとめて確認します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑刪除，右滑跳過，上滑收藏。點完成後再統一確認。"
          }
        }
      }
    },
