{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "主题与外观": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme & Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "主题与外观"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題與外觀"
          }
        }
      }
    },
    "选择界面色调，以及日间、夜间或跟随系统外观。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the interface tone, plus light, dark, or system appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "选择界面色调，以及日间、夜间或跟随系统外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇介面色調，以及日間、夜間或跟隨系統外觀。"
          }
        }
      }
    },
    "界面色调": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface Tone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "界面色调"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面色調"
          }
        }
      }
    },
    "色调会影响背景、图标、按钮和选中状态。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tone affects backgrounds, icons, buttons, and selected states."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "色调会影响背景、图标、按钮和选中状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色調會影響背景、圖標、按鈕和選中狀態。"
          }
        }
      }
    },
    "支持者版可切换更多主题。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supporter unlocks additional themes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "支持者版可切换更多主题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支持者版可切換更多主題。"
          }
        }
      }
    },
    "清透蓝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Blue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "清透蓝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清透藍"
          }
        }
      }
    },
    "青蓝背景，保持相册整理的清爽感。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blue-toned background that keeps album cleanup feeling crisp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "青蓝背景，保持相册整理的清爽感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "青藍背景，保持相簿整理的清爽感。"
          }
        }
      }
    },
    "鼠尾草绿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sage Green"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "鼠尾草绿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠尾草綠"
          }
        }
      }
    },
    "柔和一点，减少纯白界面的工具感。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Softer and calmer, with less of a plain utility feel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "柔和一点，减少纯白界面的工具感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和一點，減少純白介面的工具感。"
          }
        }
      }
    },
    "暖砂色": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm Sand"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "暖砂色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暖砂色"
          }
        }
      }
    },
    "更温暖，适合长时间整理。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmer and easier to stay with during longer cleanup sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "更温暖，适合长时间整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更溫暖，適合長時間整理。"
          }
        }
      }
    },
    "石墨灰": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "石墨灰"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "石墨灰"
          }
        }
      }
    },
    "更中性，突出照片内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More neutral, keeping attention on photo content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "更中性，突出照片内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更中性，突出照片內容。"
          }
        }
      }
    },
