        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設不再顯示已加入使用者相簿的照片"
          }
        }
      }
    },
    "没有未归类的照片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No unfiled photos found"
          }
        },
