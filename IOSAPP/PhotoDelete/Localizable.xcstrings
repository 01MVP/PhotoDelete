    "只会删除相册，不会删除相册里的照片。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف الألبوم فقط. ستبقى الصور بداخله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das Album wird gelöscht. Die Fotos darin bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the album is deleted. Photos inside it are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムだけが削除されます。中の写真は残ります。"
          }
        },
        "zh-Hans": {
