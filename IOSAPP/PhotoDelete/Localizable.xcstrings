    "01MVP 与小产品创作": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP وبناء المنتجات الصغيرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP und kleine Produkte entwickeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP and small product building"
          }
        },
        "ja": {
          "stringUnit": {
