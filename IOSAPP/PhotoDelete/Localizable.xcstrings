        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerJackie schreibt über KI-Praxis, Indie-Entwicklung und Produktexperimente und dokumentiert den Weg von der Idee bis zum Launch in 01MVP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerJackie writes about AI practice, indie development, and product experiments, and turns the path from idea to launch into 01MVP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerJackie は AI の実践、個人開発、プロジェクト実験を記録し、アイデアから公開までの小さなプロダクト作りを 01MVP にまとめています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerJackie 记录 AI 实践、独立开发和项目实验，也把从想法到上线的小产品过程整理在 01MVP。"
          }
        },
