    "免费体验 3 天进阶功能，或开通年度 Pro；永久方案可在方案页选择。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب الميزات المتقدمة مجانًا لمدة 3 أيام أو اشترك في Pro السنوي. يتوفر Pro الدائم في صفحة الخطط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Funktionen 3 Tage kostenlos testen oder Pro jährlich starten. Pro dauerhaft ist auf der Tarifseite verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try advanced features free for 3 days or start Annual Pro. Lifetime Pro is available on the plans screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度な機能を3日間無料で体験するか、年間Proを開始できます。永久Proはプラン画面で選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "免费体验 3 天进阶功能，或开通年度 Pro；永久方案可在方案页选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費體驗 3 天進階功能，或開通年度 Pro；永久方案可在方案頁選擇。"
          }
        }
      }
    },
    "年度 Pro 解锁完整时间列表、大文件清理、视频压缩、相似照片清理和主题切换。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Pro السنوي المخطط الزمني الكامل وتنظيف الملفات الكبيرة وضغط الفيديو والصور المتشابهة والسمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro jährlich schaltet die vollständige Zeitleiste, große Dateien, Videokomprimierung, ähnliche Fotos und Designs frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Annual Pro unlocks the full timeline, large-file cleanup, video compression, similar-photo cleanup, and themes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間Proで、完全な時間リスト、大容量ファイル整理、動画圧縮、類似写真整理、テーマを利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "年度 Pro 解锁完整时间列表、大文件清理、视频压缩、相似照片清理和主题切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "年度 Pro 解鎖完整時間列表、大檔案清理、影片壓縮、相似照片清理和主題切換。"
          }
        }
      }
    },
