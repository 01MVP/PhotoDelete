          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzentriert sich auf die häufigsten Entscheidungen: löschen, behalten und favorisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on the most common photo decisions: delete, keep, and favorite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真整理でよく使う判断、削除・残す・お気に入りに集中します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
