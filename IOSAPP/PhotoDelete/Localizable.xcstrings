            "state": "translated",
            "value": "隱藏已歸類照片"
          }
        }
      }
    },
    "默认不再显示已加入用户相册的照片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos already added to your albums are hidden by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认不再显示已加入用户相册的照片"
          }
