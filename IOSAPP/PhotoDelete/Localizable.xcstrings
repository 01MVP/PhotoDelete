          }
        }
      }
    },
    "压缩副本已保存，但空间减少不明显。建议先保留原视频。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ النسخة المضغوطة، لكن توفير المساحة قليل. احتفظ بالفيديو الأصلي الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die komprimierte Kopie wurde gespeichert, spart aber nur wenig Speicherplatz. Behalte das Original vorerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compressed copy was saved, but space savings are small. Keep the original for now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮コピーを保存しましたが、空き容量の増加はわずかです。今は元のビデオを残すことをおすすめします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "压缩副本已保存，但空间减少不明显。建议先保留原视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮副本已儲存，但節省空間不明顯。建議先保留原影片。"
