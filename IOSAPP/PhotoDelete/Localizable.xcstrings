    "保持原分辨率，压缩更明显，清晰度可能略有下降。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالدقة الأصلية مع ضغط أقوى. قد تقل الوضوح قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalauflösung beibehalten und stärker komprimieren. Die Schärfe kann leicht sinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the original resolution with stronger compression. Clarity may drop slightly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の解像度のまま、圧縮を強めます。鮮明さが少し下がる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "保持原分辨率，压缩更明显，清晰度可能略有下降。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持原解析度，壓縮更明顯，清晰度可能略有下降。"
          }
        }
      }
    },
    "保持原分辨率，轻微降低码率，优先保留清晰度。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالدقة الأصلية وخفّض معدل البت قليلًا مع أولوية للوضوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalauflösung beibehalten und die Bitrate leicht senken, mit Fokus auf Schärfe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the original resolution and lightly lower bitrate, prioritizing clarity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の解像度のまま、ビットレートを少し下げて鮮明さを優先します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "保持原分辨率，轻微降低码率，优先保留清晰度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持原解析度，輕微降低位元率，優先保留清晰度。"
          }
        }
      }
    },
