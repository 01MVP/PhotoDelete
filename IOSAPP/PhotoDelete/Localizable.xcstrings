    "01MVP 与小产品创作": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP and small product building"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP 與小產品創作"
          }
        }
      }
    },
    "01MVP 小产品教程": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP Small Product Guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP 小产品教程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP 小產品教程"
          }
        }
      }
    },
    "01MVP 是 MakerJackie 的 AI 产品实战教程，帮你把模糊想法拆成可验证的 MVP，并一步步走到开发、上线和迭代。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP is MakerJackie's practical AI product guide. It helps you turn a rough idea into a testable MVP, then move through development, launch, and iteration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP 是 MakerJackie 的 AI 产品实战教程，帮你把模糊想法拆成可验证的 MVP，并一步步走到开发、上线和迭代。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "01MVP 是 MakerJackie 的 AI 產品實戰教程，幫你把模糊想法拆成可驗證的 MVP，並一步步走到開發、上線和迭代。"
          }
        }
      }
    },
    "MakerJackie 记录 AI 实践、独立开发和项目实验，也把从想法到上线的小产品过程整理在 01MVP。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerJackie writes about AI practice, indie development, and product experiments, and turns the path from idea to launch into 01MVP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerJackie 记录 AI 实践、独立开发和项目实验，也把从想法到上线的小产品过程整理在 01MVP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerJackie 記錄 AI 實踐、獨立開發和項目實驗，也把從想法到上線的小產品過程整理在 01MVP。"
          }
        }
      }
    },
    "把想法做成能上线的小产品": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn an Idea Into a Launchable Small Product"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把想法做成能上线的小产品"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把想法做成能上線的小產品"
          }
        }
      }
    },
    "适合想做自己小产品，但不知道如何定范围、用 AI 写代码、处理上线细节的人。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For people who want to build their own small product but need help scoping it, coding with AI, and handling launch details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合想做自己小产品，但不知道如何定范围、用 AI 写代码、处理上线细节的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適合想做自己小產品，但不知道如何定範圍、用 AI 寫代碼、處理上線細節的人。"
          }
        }
      }
    },
