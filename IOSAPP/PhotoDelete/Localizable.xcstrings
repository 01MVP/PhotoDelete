    "4K 视频转为 1080p，1080p 及以下保持不变。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns 4K videos into 1080p and keeps 1080p or smaller videos unchanged."
