    "集中处理相似照片、大文件、图片和视频压缩。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عالج الصور المتشابهة والملفات الكبيرة وضغط الصور والفيديو في مكان واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Fotos, große Dateien sowie Bild- und Videokomprimierung zentral verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle similar photos, large files, image compression, and video compression in one place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "類似写真、大きなファイル、画像圧縮、ビデオ圧縮をまとめて処理します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "集中处理相似照片、大文件、图片和视频压缩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集中處理相似照片、大檔案、圖片和影片壓縮。"
