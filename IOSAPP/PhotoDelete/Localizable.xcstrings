    "左删右留": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف يسارًا، واحتفظ يمينًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links löschen, rechts behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete left, keep right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左で削除、右で保持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左刪右留"
          }
        }
      }
    },
    "左右浏览": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفح يمينًا أو يسارًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links oder rechts blättern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse left or right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にブラウズ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右瀏覽"
          }
        }
      }
    },
    "左右浏览，上滑删除": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفح يمينًا ويسارًا، واسحب للأعلى للحذف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links und rechts blättern, zum Löschen nach oben wischen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse left and right, swipe up to delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右でブラウズ、上スワイプで削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右浏览，上滑删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右瀏覽，上滑刪除"
          }
        }
      }
    },
    "左右滑动切换照片，不会打乱整理进度。需要清理时，再用明确的动作加入待确认列表。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب يمينًا ويسارًا للتنقل بين الصور دون تغيير تقدم المراجعة. عند التنظيف، أضف العناصر إلى قائمة التأكيد بإجراء واضح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach links und rechts, um Fotos zu wechseln, ohne den Fortschritt zu ändern. Füge Elemente bei Bedarf bewusst zur Bestätigungsliste hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left and right to move between photos without changing review progress. When you want to clean up, add items to the confirmation list intentionally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にスワイプして写真を移動しても、整理の進捗は変わりません。整理したい項目は、明確な操作で確認リストに追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "左右滑动切换照片，不会打乱整理进度。需要清理时，再用明确的动作加入待确认列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右滑動切換照片，不會打亂整理進度。需要清理時，再用明確的動作加入待確認列表。"
          }
        }
      }
    },
    "左右滑动浏览照片，上滑加入待删除；想换手势，可以在整理页底部打开设置。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب يمينًا ويسارًا للتصفح، واسحب للأعلى لوضع علامة للحذف. يمكنك تغيير الإيماءات من الإعدادات أسفل شاشة المراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische links und rechts zum Blättern, nach oben zum Markieren zum Löschen. Gesten kannst du unten auf der Prüfansicht in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left and right to browse, swipe up to mark for deletion. You can change gestures from Settings at the bottom of the review screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にスワイプして写真を見て、上にスワイプすると削除候補に追加されます。ジェスチャーは整理画面下部の設定から変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "左右滑动浏览照片，上滑加入待删除；想换手势，可以在整理页底部打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左右滑動瀏覽照片，上滑加入待刪除；想換手勢，可以在整理頁底部打開設定。"
          }
        }
      }
    },
