    "只播放当前照片，切换后会自动停止": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل العنصر الحالي فقط. يتوقف التشغيل تلقائيًا عند تبديل الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das aktuelle Element wird abgespielt. Beim Wechseln stoppt die Wiedergabe automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the current item plays. Playback stops when you switch photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の項目だけ再生します。写真を切り替えると自動停止します。"
