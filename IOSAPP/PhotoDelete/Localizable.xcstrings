    "不改变分辨率，只调整编码和码率。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى الوضوح كما هو، ويتم تعديل الترميز ومعدل البت فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auflösung bleibt unverändert, nur Codierung und Bitrate werden angepasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps resolution unchanged and adjusts encoding and bitrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解像度は変えず、エンコードとビットレートだけを調整します。"
