    "保持屏幕打开，压缩完成后会保存到照片库。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ الشاشة مفتوحة. تُحفظ النسخ المضغوطة في الصور عند الانتهاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm geöffnet lassen. Komprimierte Kopien werden danach in Fotos gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the screen open. Compressed copies are saved to Photos when finished."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を開いたままにしてください。圧縮が完了すると写真ライブラリに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "保持屏幕打开，压缩完成后会保存到照片库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
