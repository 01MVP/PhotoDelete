            "value": "Photo Delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoDelete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "PhotoDelete"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PhotoDelete"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Delete needs permission to favorite photos, add them to albums, and apply changes after you confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图需要权限来收藏照片、加入相册，并在您确认后执行选择的更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖需要權限來收藏照片、加入相簿，並在你確認後執行選擇的更改。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Delete needs access to read, organize, favorite, and delete selected photos after you confirm. We never upload or share your photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图需要访问照片库来读取、整理、收藏，并在您确认后删除选择的照片。我们不会上传或分享您的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖需要訪問照片庫來讀取、整理、收藏，並在你確認後刪除選擇的照片。我們不會上傳或分享你的照片。"
          }
        }
      }
    }
  },
  "version": "1.2"
}
