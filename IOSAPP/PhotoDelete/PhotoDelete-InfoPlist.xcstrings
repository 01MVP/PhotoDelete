    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج OnePhoto إلى إذن لتمييز الصور كمفضلة وإضافتها إلى الألبومات وحفظ نسخ مضغوطة وتطبيق التغييرات بعد تأكيدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhoto benötigt die Berechtigung, um Fotos als Favoriten zu markieren, zu Alben hinzuzufügen, komprimierte Kopien zu sichern und Änderungen nach Ihrer Bestätigung anzuwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhoto needs permission to favorite photos, add them to albums, save compressed copies, and apply changes after you confirm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhotoは、写真をお気に入りに追加し、アルバムへ追加し、圧縮コピーを保存し、確認後に変更を適用するために権限が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图需要权限来收藏照片、加入相册、保存压缩副本，并在您确认后执行选择的更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖需要權限來收藏照片、加入相簿、保存壓縮副本，並在你確認後執行選擇的更改。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج OnePhoto إلى الوصول إلى مكتبة الصور لقراءة الصور المحددة وتنظيمها وتمييزها كمفضلة وحذفها بعد تأكيدك. لا نرفع صورك أو نشاركها مطلقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhoto benötigt Zugriff auf Ihre Fotomediathek, um ausgewählte Fotos nach Ihrer Bestätigung zu lesen, zu organisieren, als Favoriten zu markieren und zu löschen. Wir laden Ihre Fotos niemals hoch und teilen sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhoto needs access to read, organize, favorite, and delete selected photos after you confirm. We never upload or share your photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OnePhotoは、確認後に選択した写真を読み込み、整理し、お気に入りに追加し、削除するために写真ライブラリへのアクセスが必要です。写真をアップロードしたり共有したりすることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图需要访问照片库来读取、整理、收藏，并在您确认后删除选择的照片。我们不会上传或分享您的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖需要訪問照片庫來讀取、整理、收藏，並在你確認後刪除選擇的照片。我們不會上傳或分享你的照片。"
          }
        }
      }
    }
  },
  "version": "1.2"
}
