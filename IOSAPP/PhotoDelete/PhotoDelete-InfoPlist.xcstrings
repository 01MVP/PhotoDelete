            "value": "PhotoDelete"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Delete needs permission to add photos to albums you choose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图需要权限来把照片加入您选择的相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖需要權限來把照片加入您選擇的相冊。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Delete needs access to your photo library to help you organize and manage photos. We never upload or share your photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "删图需要访问您的照片库来帮助您整理和管理照片。我们不会上传或分享您的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪圖需要訪問您的照片庫來幫助您整理和管理照片。我們不會上傳或分享您的照片。"
          }
        }
      }
    }
  },
  "version": "1.2"
}
